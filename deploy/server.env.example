# Copy this file to deploy/server.env on the deployment host.
# Never commit deploy/server.env or put real credentials in this file.

# The production compose file overrides this with the persistent volume path.
DATABASE_URL=file:/data/zarbit.db

# Public origin of the web application. Must match the browser-facing URL.
CORS_ORIGIN=https://app.example.com
NODE_ENV=production

# Standard Telegram Bot API token (BotFather).
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token

# Comma-separated Telegram user IDs allowed to use the Mini App.
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321

# Reference for a standalone server process; production Compose uses explicit env.
NODE_ENV=production
DATABASE_URL=postgresql://zarbit_app:replace-with-password@db.example.com:5432/zarbit?sslmode=require
DATABASE_POOL_MAX=5
CORS_ORIGIN=https://app.example.com
WEB_APP_URL=https://app.example.com
TELEGRAM_BOT_TOKEN=replace-with-bot-token
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321
WORKER_INTERNAL_URL=http://worker:3002
WORKER_INTERNAL_TOKEN=replace-with-a-random-secret-at-least-32-characters
# No TELEGRAM_API_ID/HASH, session directory or session volume on the server.

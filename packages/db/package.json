{
  "name": "@zarbit/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "test": "tsx --test test/*.test.ts",
    "postinstall": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@zarbit/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:",
    "@zarbit/contracts": "workspace:*",
    "@zarbit/domain": "workspace:*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@zarbit/config": "workspace:*",
    "@types/pg": "^8.15.5",
    "prisma": "^7.9.1",
    "tsx": "^4.23.1",
    "typescript": "catalog:"
  }
}

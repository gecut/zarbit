generator client {
  provider = "prisma-client"
  output   = "../generated"
  moduleFormat = "esm"
  runtime = "nodejs"
}

datasource db {
  provider = "sqlite"
}

enum RequestCondition {
  LTE
  GTE
}

enum RequestAction {
  ALERT
  BUY
  SELL
}

enum RequestStatus {
  ACTIVE
  DONE
  CANCELLED
  FAILED
}

enum TelegramSessionState {
  PENDING_OTP
  ACTIVE
  NOT_IN_GROUP
  REVOKED
  REVOKING
  ERROR
}

model TelegramUser {
  id             String    @id @default(cuid())
  telegramUserId String    @unique
  firstName      String?
  username       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  requests       Request[]
  telegramSession TelegramSession?
}

model TelegramSession {
  id                      String               @id @default(cuid())
  userId                  String               @unique
  storageKey              String?              @unique
  connectedTelegramUserId String?              @unique
  state                   TelegramSessionState @default(PENDING_OTP)
  revision                Int                  @default(0)
  runtimeReady            Boolean              @default(false)
  runtimeCheckedAt        DateTime?
  membershipCheckedAt     DateTime?
  lastError               String?
  stateChangedAt          DateTime             @default(now())
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  user                    TelegramUser         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([state, updatedAt])
}

model Request {
  id                 String           @id @default(cuid())
  userId             String
  condition          RequestCondition
  targetPrice        Int
  action             RequestAction
  units              Int?
  status             RequestStatus    @default(ACTIVE)
  claimToken         String?          @unique
  claimedAt          DateTime?
  triggeredQuote     Int?
  triggeredMessageId Int?
  outgoingMessageId  Int?
  completedAt        DateTime?
  failureReason      String?
  cancellationReason String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               TelegramUser     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, claimToken])
}

model LoginRateLimit {
  key             String   @id
  windowStartedAt DateTime
  count           Int      @default(0)
  blockedUntil    DateTime?
}

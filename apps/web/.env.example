# Local development defaults to mock data, with no running API required.
# Set this to server to exercise the real local API instead.
VITE_API_MODE=mock
# Mock dashboard states: ?quoteScenario=normal|empty|loading|stale|error
# Mock session states: ?sessionScenario=active|disconnected|login_pending|not_in_group|degraded|revoked|error
# Mock requests states: ?requestsScenario=default|empty

# Public value embedded into production Vite builds. Do not place secrets here.
VITE_SERVER_URL=https://api.example.com

# Build-time rollback only; the default transport is rpc.
VITE_RPC_TRANSPORT=rpc

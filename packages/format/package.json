{
  "name": "@zarbit/format",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src test",
    "format": "prettier --ignore-path ../../.prettierignore --write .",

generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum TelegramSessionState {
  PENDING_OTP
  ACTIVE
  NOT_IN_GROUP
  REVOKED
  REVOKING
  ERROR
}

enum TelegramConnectionState {
  CONNECTED
  CONNECTING
  OFFLINE
  DEGRADED
}

enum RequestExecutionPhase {
  WAITING_TRADE
  CLAIMED
  SENDING
  DONE
  FAILED
  CANCELLED
  UNKNOWN
}

enum RequestResolutionState {
  NOT_APPLICABLE
  UNRESOLVED
}

model TelegramUser {
  id              String           @id @default(cuid())
  telegramUserId  String           @unique
  firstName       String?
  username        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  telegramSession TelegramSession?
  requests        Request[]
  telegramOperations TelegramOperation[]
}

model TelegramSession {
  id                      String               @id @default(cuid())
  userId                  String               @unique
  storageKey              String?              @unique
  connectedTelegramUserId String?              @unique
  state                   TelegramSessionState @default(PENDING_OTP)
  connectionState         TelegramConnectionState @default(OFFLINE)
  reasonCode              String?
  lastObservedAt          DateTime             @default(now())
  lastErrorCode           String?
  revokedAt               DateTime?
  revision                Int                  @default(0)
  version                 Int                  @default(0)
  loginId                 String?
  runtimeReady            Boolean              @default(false)
  runtimeCheckedAt        DateTime?
  membershipCheckedAt     DateTime?
  lastError               String?
  stateChangedAt          DateTime             @default(now())
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  user                    TelegramUser         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([state, updatedAt])
  @@index([state, connectionState])
}

enum TelegramOperationStatus {
  ACCEPTED
  RUNNING
  SUCCEEDED
  FAILED
  CANCEL_REQUESTED
  CANCELLED
  INTERRUPTED
}

model TelegramOperation {
  userId String
  id String @db.Uuid
  type String
  status TelegramOperationStatus @default(ACCEPTED)
  revision Int
  challengeId String? @db.Uuid
  requestId String
  acceptedAt DateTime @default(now())
  completedAt DateTime?
  errorCode String?
  errorMessage String?
  errorField String?
  retryAt DateTime?
  cancelledRequests Int @default(0)
  sendingRequests Int @default(0)
  user TelegramUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@index([userId, status, acceptedAt])
  @@index([completedAt])
}

model LoginRateLimit {
  key             String    @id
  windowStartedAt DateTime
  count           Int       @default(0)
  blockedUntil    DateTime?
}

enum RequestCondition {
  GTE
  LTE
}

enum RequestAction {
  ALERT
  BUY
  SELL
}

enum RequestStatus {
  ACTIVE
  DONE
  CANCELLED
  FAILED
  UNKNOWN
}

model Request {
  id                  String                 @id @default(cuid())
  userId              String
  condition           RequestCondition
  action              RequestAction
  targetPrice         Int
  units               Int?
  status              RequestStatus          @default(ACTIVE)
  executionPhase      RequestExecutionPhase  @default(WAITING_TRADE)
  outcomeCode         String?
  deliveryStartedAt   DateTime?
  unknownReason       String?
  resolutionState     RequestResolutionState @default(NOT_APPLICABLE)
  claimToken          String?                @unique
  armedAt             DateTime               @default(now())
  armedAfterMessageId Int                    @default(0)
  triggeredPrice      Int?
  triggerSource       RequestTriggerSource?
  triggeredTradeId    String?
  triggeredChatId     BigInt?
  triggeredAt         DateTime?
  triggeredMessageId  Int?
  outgoingMessageId   Int?
  completedAt         DateTime?
  failureReason       String?
  cancellationReason  String?
  creationKey         String?                @db.Uuid
  creationPayloadHash String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  user                TelegramUser           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, creationKey])
  @@index([userId, status, createdAt])
  @@index([status, condition, targetPrice])
}

model RequestCreationIdentity {
  id                  String        @id @default(cuid())
  userId              String
  creationKey         String        @db.Uuid
  creationPayloadHash String
  requestId           String        @unique
  status              RequestStatus
  completedAt         DateTime?
  createdAt           DateTime      @default(now())

  @@unique([userId, creationKey])
  @@index([userId, createdAt])
}

model QuoteHistory {
  id              Int      @id @default(autoincrement())
  chatId          BigInt?
  compactQuote    Int
  announcedAt     DateTime
  receivedAt      DateTime
  sourceMessageId Int      @unique
  createdAt       DateTime @default(now())

  @@index([announcedAt])
  @@index([announcedAt, sourceMessageId])
  @@index([chatId, sourceMessageId])
}

enum ParticipantResolutionStatus {
  UNRESOLVED
  CANDIDATE
  VERIFIED
  CONFLICT
  CONFLICT_FLAGGED
}

model Participant {
  id                String                      @id
  telegramUserId    String?                     @unique
  resolutionStatus  ParticipantResolutionStatus @default(UNRESOLVED)
  confirmationCount Int                         @default(0)
  lastConfirmedAt   DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  actions           TradingAction[]
  buyerTrades       Trade[]                     @relation("BuyerTrades")
  sellerTrades      Trade[]                     @relation("SellerTrades")
}

enum TradingSide {
  BUY
  SELL
}

enum TradeType {
  NORMAL
  SETTLEMENT
}

enum SettlementStatus {
  RECEIVED
  APPLIED
  REVIEW_REQUIRED
}

enum TradingActionType {
  ORDER_BUY
  ORDER_SELL
  TAKE_ALL
  TAKE_QUANTITY
  CANCEL
}

enum TradingActionStatus {
  OBSERVED
  CONFIRMED_BY_BOT
  REJECTED_BY_BOT
  AMBIGUOUS
  UNRESOLVED_TARGET
}

model TradingAction {
  id                   String              @id @default(cuid())
  chatId               BigInt
  sourceMessageId      Int
  senderId             String
  actionType           TradingActionType
  side                 TradingSide?
  rawText              String
  quantity             Int?
  compactPrice         Int?
  replyToMessageId     Int?
  replyToSenderId      String?
  targetOrderMessageId Int?
  status               TradingActionStatus @default(OBSERVED)
  confirmedByMessageId Int?
  participantId        String?
  observedAt           DateTime
  createdAt            DateTime            @default(now())

  participant Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@unique([chatId, sourceMessageId])
  @@unique([chatId, confirmedByMessageId])
  @@index([sourceMessageId])
  @@index([senderId, observedAt])
  @@index([participantId, observedAt])
  @@index([targetOrderMessageId])
  @@index([observedAt, sourceMessageId])
}

model Trade {
  id                  String    @id @default(cuid())
  chatId              BigInt
  sourceMessageId     Int?
  type                TradeType @default(NORMAL)
  referenceNumber     String?
  buyerParticipantId  String?
  sellerParticipantId String?
  settlementMessageId Int?
  quantity            Int
  compactPrice        Int
  rawPrice            BigInt
  receiptTimeText     String?
  announcedAt         DateTime
  createdAt           DateTime  @default(now())

  buyerParticipant  Participant? @relation("BuyerTrades", fields: [buyerParticipantId], references: [id], onDelete: Restrict)
  sellerParticipant Participant? @relation("SellerTrades", fields: [sellerParticipantId], references: [id], onDelete: Restrict)
  settlement        Settlement?  @relation(fields: [chatId, settlementMessageId], references: [chatId, sourceMessageId], onDelete: Restrict, map: "Trade_settlement_fkey")

  @@unique([chatId, sourceMessageId])
  @@index([sourceMessageId])
  @@index([announcedAt, sourceMessageId])
  @@index([buyerParticipantId, announcedAt])
  @@index([sellerParticipantId, announcedAt])
  @@index([referenceNumber])
  @@index([chatId, settlementMessageId])
}

model Settlement {
  id                 String           @id @default(cuid())
  chatId             BigInt
  sourceMessageId    Int
  senderId           String
  compactPrice       Int
  announcedAt        DateTime
  payloadHash        String
  status             SettlementStatus @default(RECEIVED)
  reviewReason       String?
  coverageDigest     String?
  coverageReviewedBy String?
  isBootstrap        Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  trades             Trade[]

  @@unique([chatId, sourceMessageId])
}

model FinancialInbox {
  id              String    @id @default(cuid())
  chatId          BigInt
  sourceMessageId Int
  senderId        String
  eventKind       String
  rawText         String?
  payloadHash     String
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  errorCode       String?

  @@unique([chatId, sourceMessageId, eventKind, payloadHash], map: "FinancialInbox_observation_key")
}

model GroupIngestionState {
  chatId                           BigInt   @id
  historyRecoveryRequired          Boolean  @default(false)
  historyRecoveryGeneration        Int      @default(0)
  scannedThroughMessageId          Int      @default(0)
  appliedThroughMessageId          Int      @default(0)
  coverageVerifiedThroughMessageId Int      @default(0)
  coverageDigest                   String?
  gateStatus                       String   @default("OPEN")
  analyticsRevision                Int      @default(0)
  updatedAt                        DateTime @updatedAt
}

enum RequestTriggerSource {
  QUOTE
  TRADE
}

model TradeRequestCursor {
  chatId          BigInt @id
  sourceMessageId Int    @default(0)
}

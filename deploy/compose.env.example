# Copy this file to .env beside docker-compose.production.yml on the host.
# These values select images; service secrets live in deploy/server.env and
# deploy/worker.env. Configure public domains and service ports in Dokploy.

# The GHCR image prefix produced by publish-containers.yml.
GHCR_IMAGE_PREFIX=ghcr.io/your-github-user/zarbit
IMAGE_TAG=latest

# Browser origin allowed by the API.
CORS_ORIGIN=https://app.example.com

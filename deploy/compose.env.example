# Copy this file to .env beside docker-compose.production.yml on the host.
# These values select images and Traefik domains; service secrets live in
# deploy/server.env and deploy/worker.env.

# The GHCR image prefix produced by publish-containers.yml.
GHCR_IMAGE_PREFIX=ghcr.io/your-github-user/zarbit
IMAGE_TAG=latest

# Domains configured in Traefik/Dokploy DNS.
WEB_DOMAIN=app.example.com
API_DOMAIN=api.example.com
TRAEFIK_CERT_RESOLVER=letsencrypt

# Browser origin allowed by the API.
CORS_ORIGIN=https://app.example.com

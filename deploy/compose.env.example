# Dokploy writes values from its Compose Environment UI to .env and the
# production compose injects that file into the runtime services.
# Keep this file as placeholders only. Never commit real credentials.

# Published image selection.
GHCR_IMAGE_PREFIX=ghcr.io/your-github-user/zarbit
IMAGE_TAG=latest

# Browser-facing Mini App origin and Bot API launcher URL.
CORS_ORIGIN=https://app.example.com
WEB_APP_URL=https://app.example.com

# Standard Telegram Bot API credential.
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token

# Global Telegram application credentials and fixed group quote source.
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace-with-telegram-api-hash
TELEGRAM_GROUP_ID=-1001234567890
QUOTE_SENDER_ID=123456789

# Comma-separated Telegram IDs authorized to use the Mini App.
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321
MAX_TELEGRAM_SESSIONS=20

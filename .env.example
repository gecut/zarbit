# Zarbit complete environment reference.
# For production Compose, copy deploy/compose.env.example to .env and copy
# deploy/server.env.example + deploy/worker.env.example to their runtime files.
# This file contains placeholders only; never commit real credentials.

# ---- Compose image selection and Traefik domains ----
GHCR_IMAGE_PREFIX=ghcr.io/your-github-user/zarbit
IMAGE_TAG=latest
WEB_DOMAIN=app.example.com
API_DOMAIN=api.example.com
TRAEFIK_CERT_RESOLVER=letsencrypt
CORS_ORIGIN=https://app.example.com

# ---- Server / Prisma ----
DATABASE_URL=file:/data/zarbit.db
NODE_ENV=production

# ---- Telegram Bot API (server) ----
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321

# ---- Telegram MTProto worker ----
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace-with-telegram-api-hash
TELEGRAM_GROUP_ID=-1001234567890
QUOTE_SENDER_ID=123456789
WORKER_KEEP_ALIVE=true

# ---- Web build-only public value ----
# This is consumed by Vite at image build time, not by the runtime container.
VITE_SERVER_URL=https://api.example.com

# Local development. Both processes must point to the SAME absolute database file.
NODE_ENV=development
DATABASE_URL=file:/absolute/path/to/zarbit/local.db
CORS_ORIGIN=http://localhost:3001
WEB_APP_URL=https://app.example.com
TELEGRAM_BOT_TOKEN=replace-with-bot-token
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321
WORKER_INTERNAL_URL=http://127.0.0.1:3002
WORKER_INTERNAL_TOKEN=replace-with-a-random-secret-at-least-32-characters
# Optional local UI bypass, never accepted in production; still requires allowlist.
DEV_TELEGRAM_USER_ID=

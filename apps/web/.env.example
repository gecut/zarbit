# ZarBit Web Configuration
# Local development connects directly to the server API (defaults to http://localhost:3000).
VITE_SERVER_URL=http://localhost:3000

# Public value embedded into production Vite builds. Do not place secrets here.
# For production builds, supply your public HTTPS API endpoint:
# VITE_SERVER_URL=https://api.example.com

# Build-time rollback only; the default transport is rpc.


# Development-only deterministic Home fixtures: open /?marketScenario=normal
# Production builds always use the authenticated RPC transport.

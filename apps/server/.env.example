# Local/server runtime values. For production, use deploy/server.env.
DATABASE_URL=file:./local.db
CORS_ORIGIN=http://localhost:3001
NODE_ENV=development
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
# Global Telegram application credentials. These do not belong to end users.
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace-with-telegram-api-hash
TELEGRAM_GROUP_ID=-1001234567890
TELEGRAM_SESSIONS_DIR=./telegram-sessions
MAX_TELEGRAM_SESSIONS=20
WEB_APP_URL=https://app.example.com
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321
# Optional, development only. This account must still be in the allowlist.
DEV_TELEGRAM_USER_ID=

# Local development. Match server's PostgreSQL database and internal token.
NODE_ENV=development
DATABASE_URL=postgresql://postgres:replace-with-password@127.0.0.1:5432/zarbit?schema=public
DATABASE_POOL_MAX=5
TELEGRAM_SESSIONS_DIR=./telegram-sessions
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace-with-your-32-character-api-hash
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_GROUP_ID=-1001234567890
QUOTE_SENDER_ID=123456789
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321
MAX_TELEGRAM_SESSIONS=20
WORKER_INTERNAL_TOKEN=replace-with-a-random-secret-at-least-32-characters
LOG_LEVEL=info

# Optional Mini App buttons in private notifications
WEB_APP_URL=https://app.example.com

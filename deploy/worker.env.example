# Copy this file to deploy/worker.env on the deployment host.
# Never commit deploy/worker.env or put real credentials in this file.

NODE_ENV=production

# Telegram application credentials from https://my.telegram.org.
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace-with-telegram-api-hash

# Target trading group and quote source IDs.
TELEGRAM_GROUP_ID=-1001234567890
QUOTE_SENDER_ID=123456789

# Keep the foundation process alive until mtcute behavior is implemented.
WORKER_KEEP_ALIVE=true

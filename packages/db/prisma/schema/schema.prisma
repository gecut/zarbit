generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum TelegramSessionState {
  PENDING_OTP
  ACTIVE
  NOT_IN_GROUP
  REVOKED
  REVOKING
  ERROR
}

enum TelegramConnectionState {
  CONNECTED
  CONNECTING
  OFFLINE
  DEGRADED
}

enum RequestExecutionPhase {
  WAITING_QUOTE
  CLAIMED
  SENDING
  DONE
  FAILED
  CANCELLED
  UNKNOWN
}

enum RequestResolutionState {
  NOT_APPLICABLE
  UNRESOLVED
}

model TelegramUser {
  id              String           @id @default(cuid())
  telegramUserId  String           @unique
  firstName       String?
  username        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  telegramSession TelegramSession?
  requests        Request[]
}

model TelegramSession {
  id                      String               @id @default(cuid())
  userId                  String               @unique
  storageKey              String?              @unique
  connectedTelegramUserId String?              @unique
  state                   TelegramSessionState @default(PENDING_OTP)
  connectionState         TelegramConnectionState @default(OFFLINE)
  reasonCode              String?
  lastObservedAt          DateTime             @default(now())
  lastErrorCode           String?
  revokedAt               DateTime?
  revision                Int                  @default(0)
  runtimeReady            Boolean              @default(false)
  runtimeCheckedAt        DateTime?
  membershipCheckedAt     DateTime?
  lastError               String?
  stateChangedAt          DateTime             @default(now())
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  user                    TelegramUser         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([state, updatedAt])
  @@index([state, connectionState])
}

model LoginRateLimit {
  key             String    @id
  windowStartedAt DateTime
  count           Int       @default(0)
  blockedUntil    DateTime?
}

enum RequestCondition {
  GTE
  LTE
}

enum RequestAction {
  ALERT
  BUY
  SELL
}

enum RequestStatus {
  ACTIVE
  DONE
  CANCELLED
  FAILED
  UNKNOWN
}

model Request {
  id                 String           @id @default(cuid())
  userId             String
  condition          RequestCondition
  action             RequestAction
  targetPrice        Int
  units              Int?
  status             RequestStatus    @default(ACTIVE)
  executionPhase     RequestExecutionPhase @default(WAITING_QUOTE)
  outcomeCode        String?
  deliveryStartedAt  DateTime?
  unknownReason      String?
  resolutionState    RequestResolutionState @default(NOT_APPLICABLE)
  claimToken         String?          @unique
  triggeredQuote     Int?
  triggeredMessageId Int?
  outgoingMessageId  Int?
  completedAt        DateTime?
  failureReason      String?
  cancellationReason String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               TelegramUser     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([status, condition, targetPrice])
}

model QuoteHistory {
  id              Int      @id @default(autoincrement())
  chatId          BigInt?
  compactQuote    Int
  announcedAt     DateTime
  receivedAt      DateTime
  sourceMessageId Int      @unique
  createdAt       DateTime @default(now())

  @@index([announcedAt])
  @@index([announcedAt, sourceMessageId])
}

enum ParticipantResolutionStatus {
  UNRESOLVED
  CANDIDATE
  VERIFIED
  CONFLICT
  CONFLICT_FLAGGED
}

model Participant {
  id                String                      @id
  telegramUserId    String?
  resolutionStatus  ParticipantResolutionStatus @default(UNRESOLVED)
  confirmationCount Int                         @default(0)
  lastConfirmedAt   DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  actions           TradingAction[]
  buyerTrades       Trade[]                     @relation("BuyerTrades")
  sellerTrades      Trade[]                     @relation("SellerTrades")

  @@index([telegramUserId])
}

enum TradingActionType {
  ORDER_BUY
  ORDER_SELL
  TAKE_ALL
  TAKE_QUANTITY
  CANCEL
}

enum TradingActionStatus {
  OBSERVED
  CONFIRMED_BY_BOT
  REJECTED_BY_BOT
  AMBIGUOUS
  UNRESOLVED_TARGET
}

model TradingAction {
  id                   String              @id @default(cuid())
  chatId               BigInt
  sourceMessageId      Int
  senderId             String
  actionType           TradingActionType
  rawText              String
  quantity             Int?
  compactPrice         Int?
  replyToMessageId     Int?
  replyToSenderId      String?
  targetOrderMessageId Int?
  status               TradingActionStatus @default(OBSERVED)
  confirmedByMessageId Int?
  participantId        String?
  observedAt           DateTime
  createdAt            DateTime            @default(now())

  participant          Participant?        @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@unique([chatId, sourceMessageId])
  @@index([sourceMessageId])
  @@index([senderId, observedAt])
  @@index([participantId, observedAt])
  @@index([targetOrderMessageId])
  @@index([observedAt, sourceMessageId])
  @@unique([chatId, confirmedByMessageId])
}

model Trade {
  id                  String      @id @default(cuid())
  chatId              BigInt
  sourceMessageId     Int
  referenceNumber     String?
  buyerParticipantId  String
  sellerParticipantId String
  quantity            Int
  compactPrice        Int
  rawPrice            BigInt
  receiptTimeText     String?
  announcedAt         DateTime
  createdAt           DateTime    @default(now())

  buyerParticipant    Participant @relation("BuyerTrades", fields: [buyerParticipantId], references: [id])
  sellerParticipant   Participant @relation("SellerTrades", fields: [sellerParticipantId], references: [id])

  @@unique([chatId, sourceMessageId])
  @@index([sourceMessageId])
  @@index([announcedAt, sourceMessageId])
  @@index([buyerParticipantId, announcedAt])
  @@index([sellerParticipantId, announcedAt])
  @@index([referenceNumber])
}

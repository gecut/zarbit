# Copy into the Dokploy Compose Environment UI (or .env on a standalone host).
# Compose forwards only explicitly listed values to each service. No runtime env_file.
# Replace all placeholders. Never commit real credentials.
GHCR_IMAGE_PREFIX=ghcr.io/gecut/zarbit
# Use the same immutable published tag for all three images.
IMAGE_TAG=replace-with-an-immutable-release-tag
# Written to server/worker logs. Use immutable image tag in production.
DATABASE_URL=postgresql://postgres:replace-with-password@db.example.com:5432/zarbit
MIGRATION_DATABASE_URL=postgresql://postgres:replace-with-password@db.example.com:5432/zarbit
DATABASE_POOL_MAX=5
LOG_LEVEL=info
CORS_ORIGIN=https://app.example.com
WEB_APP_URL=https://app.example.com
TELEGRAM_BOT_TOKEN=replace-with-bot-token
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321

# Worker only: one global Telegram application; separate session for each user.
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace-with-your-32-character-api-hash
TELEGRAM_GROUP_ID=-1001234567890
QUOTE_SENDER_ID=123456789
SETTLEMENT_SENDER_ID=
SETTLEMENT_ENABLED=false
SETTLEMENT_BOOTSTRAP_MESSAGE_ID=
MAX_TELEGRAM_SESSIONS=20

# Generate once using: openssl rand -hex 32
# Same value is injected into server and worker. Keep stable across restarts.
WORKER_INTERNAL_TOKEN=replace-with-a-random-secret-at-least-32-characters

# Public BUILD argument, not a runtime web variable.
# Also set this in GitHub repository Settings > Variables > Actions.
VITE_SERVER_URL=https://api.example.com

generator client {
  provider = "prisma-client"
  output   = "../generated"
  moduleFormat = "esm"
  runtime = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum TelegramSessionState {
  PENDING_OTP
  ACTIVE
  NOT_IN_GROUP
  REVOKED
  REVOKING
  ERROR
}

model TelegramUser {
  id             String    @id @default(cuid())
  telegramUserId String    @unique
  firstName      String?
  username       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  telegramSession TelegramSession?
}

model TelegramSession {
  id                      String               @id @default(cuid())
  userId                  String               @unique
  storageKey              String?              @unique
  connectedTelegramUserId String?              @unique
  state                   TelegramSessionState @default(PENDING_OTP)
  revision                Int                  @default(0)
  runtimeReady            Boolean              @default(false)
  runtimeCheckedAt        DateTime?
  membershipCheckedAt     DateTime?
  lastError               String?
  stateChangedAt          DateTime             @default(now())
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  user                    TelegramUser         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([state, updatedAt])
}

model LoginRateLimit {
  key             String   @id
  windowStartedAt DateTime
  count           Int      @default(0)
  blockedUntil    DateTime?
}

model LatestQuote {
  id              Int      @id @default(1)
  compactQuote    Int
  announcedAt     DateTime
  receivedAt      DateTime
  sourceMessageId Int
  updatedAt       DateTime @updatedAt
}

model QuoteHistory {
  id              Int      @id @default(autoincrement())
  compactQuote    Int
  announcedAt     DateTime
  receivedAt      DateTime
  sourceMessageId Int      @unique
  createdAt       DateTime @default(now())

  @@index([announcedAt])
}
